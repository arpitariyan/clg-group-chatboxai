# =============================================================================
# ⚠️  SECURITY CONFIGURATION  ⚠️
# =============================================================================
# ADMIN_EMAILS: Comma-separated list of emails with admin panel access
ADMIN_EMAILS=your-admin@example.com

# PROTECTED_ADMIN_EMAIL: This account will never be downgraded by webhook (e.g. app owner)
PROTECTED_ADMIN_EMAIL=

# ALLOWED_CORS_ORIGINS: Comma-separated origins allowed to call your API (production)
ALLOWED_CORS_ORIGINS=https://chatboxai.co.in,https://www.chatboxai.co.in

# NEXTAUTH_SECRET: Secret for session signing & OTP hashing (generate: openssl rand -hex 32)
NEXTAUTH_SECRET=

# =============================================================================
# ⚠️  API KEY SECURITY NOTE  ⚠️
